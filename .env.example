# Postgres. Local dev uses the Homebrew server; in production point this at
# Neon, Supabase or Vercel Postgres.
DATABASE_URL=postgres://user@localhost:5432/acuse

# Guards POST /api/cron so only the scheduler can drain the queue.
CRON_SECRET=change-me

# Where the app reaches itself (used by the demo destination in the seed data).
APP_URL=http://localhost:3000
